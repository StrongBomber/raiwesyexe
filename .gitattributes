# Android binary artifacts are huge (this bundle alone is ~227 MiB) — they must go
# through Git LFS, never into the plain Git object store.
# GitHub rejects any single file over 100 MB on a normal push, so a bare `git add`
# of the .xapk would be refused outright.
#
# Requires: git lfs install   (once per machine)
apk/*.xapk filter=lfs diff=lfs merge=lfs -text
apk/*.apk  filter=lfs diff=lfs merge=lfs -text
apk/*.aab  filter=lfs diff=lfs merge=lfs -text
apk/*.obb  filter=lfs diff=lfs merge=lfs -text
*.xapk     filter=lfs diff=lfs merge=lfs -text
*.obb      filter=lfs diff=lfs merge=lfs -text
